{
  "_meta": {
    "version": "v2-2026-05-23",
    "form": "SF 86 — Questionnaire for National Security Positions (Standard Form 86, OPM)",
    "purpose": "Section-by-section catalog of every SF 86 question with a pointer to where it lives in our schema. The audit script `scripts/audit_sf86_coverage.py` walks this file against information_schema and reports missing tables / fields / picklists.",
    "coverage_legend": {
      "FULL":    "Question fully captured by a structured field in our schema",
      "PARTIAL": "Question captured but with missing sub-fields or no picklist",
      "FLAG":    "Captured only as a yes/no via applicant_form_response (no structured detail)",
      "MISSING": "No schema coverage yet — needs a new table or column"
    },
    "schema_files_referenced": [
      "scripts/db/005_schema.sql", "scripts/db/008_schema.sql",
      "scripts/db/010_schema.sql", "scripts/db/011_schema.sql"
    ],
    "picklists_canonical_at": "data/sf86_picklists.json"
  },
