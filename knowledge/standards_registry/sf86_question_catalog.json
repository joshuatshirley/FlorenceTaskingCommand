  "deduplication_strategy": {
    "purpose": "Ensure the same fact isn't entered twice in different places. SF 86 has natural overlap (e.g. spouse appears in §17 marital AND §18 relatives; foreign country appears in §11 residence + §19 contacts + §20C travel; employer appears in §13A + §16 references).",
    "rules": [
      {
        "rule": "Spouse = applicant_family_member.relationship='spouse'; marital metadata lives in applicant_marital_history with FK to that family_member.id. §17 reads from both tables; do not duplicate name fields.",
        "implemented_via": "FK applicant_marital_history.family_member_id -> applicant_family_member.id (011_schema.sql)"
      },
      {
        "rule": "Foreign exposure (country surfaced in residence + travel + contacts + business + financial interest) is unified in v_applicant_foreign_exposure for one-screen review.",
        "implemented_via": "View v_applicant_foreign_exposure (011_schema.sql)"
      },
      {
        "rule": "Employer in §13 employment + §16 character reference: reference rows that name an employer FK back to applicant_employment.id when applicable.",
        "implemented_via": "applicant_character_reference.referenced_employment_id (011_schema.sql)"
      },
      {
        "rule": "Employer in §13 + §27 IT violation: IT violation row FKs to the employment row where the violation occurred, avoiding duplicate employer entry.",
        "implemented_via": "applicant_it_violation.referenced_employment_id (011_schema.sql)"
      },
      {
        "rule": "Legal event in §22 police + §28 civil court: civil court rows do NOT duplicate criminal arrests; distinct tables.",
        "implemented_via": "applicant_legal_event.event_type CHECK excludes civil events; applicant_civil_court_action holds civil only."
      },
      {
        "rule": "Mental-health diagnosis flag (§21) + medical_event row: mh_detail.has_X is a yes/no rollup that the validator can match against medical_event rows for detail; condition matcher uses both signals.",
        "implemented_via": "eod.applicant.matching.MH_FLAG_MAP"
      },
      {
        "rule": "Picklist values consolidated in data/sf86_picklists.json; SQL CHECK constraints duplicate them; tests/test_picklist_consistency.py asserts no drift.",
        "implemented_via": "Test test_registry_matches_sql_check_constraints"
      }
    ]
  }
}
