    "purpose": "Initial seed of DoDI 6130.03 disqualifying conditions. Each row is one condition with: ICD-10 codes for matching against applicant medical events, a `rule` JSONB that the evaluator interprets, waiver path, and citation. NOT exhaustive — DoDI 6130.03 has hundreds of conditions across 14 body systems. This seed covers the ~50 highest-frequency conditions a recruiter actually encounters. Extend by adding entries to this file then re-running `doctrine standards seed-conditions`.",
    "rule_types": {
      "simple":             "any documented occurrence is disqualifying",
      "temporal_treatment": "DQ if currently treated OR treatment ended < recency_months ago",
      "temporal_episode":   "DQ if any episode occurred < recency_months ago",
      "recurrence":         "DQ if episodes_min met within window_years",
      "surgery_recency":    "DQ until months_post_op_min has passed",
      "severity_threshold": "DQ above the named severity level",
      "asthma_temporal":    "DQ if asthma symptoms/treatment after age threshold"
    },
    "citation_root": "DoDI 6130.03 — Medical Standards for Military Service: Appointment, Enlistment, or Induction"
  },
