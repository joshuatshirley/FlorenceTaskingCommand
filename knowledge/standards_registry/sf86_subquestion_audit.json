    "version": "v1-2026-05-23",
    "purpose": "Sub-question-level audit of every SF 86 field. The section-level catalog (sf86_question_catalog.json) reports 33/33 FULL by section, but sections have many sub-questions; this file lists each one explicitly and tells you which DB column captures it. Run scripts/audit_sf86_subquestions.py to see what's still missing.",
    "coverage_legend": {
      "CAPTURED":     "Sub-question has a dedicated structured column",
      "CAPTURED_ENC": "Captured in an encrypted PII column",
      "DERIVED":      "Captured by another column (no dedicated field needed)",
      "NOTES":        "Captured only in a free-text notes field — searchable but unstructured",
      "FORM_RESPONSE": "Only captured via applicant_form_response yes/no",
      "MISSING":      "No place to put this answer; needs a column addition"
    }
  },
