     "note":"DoDI 6130.03 condition `asthma_after_13` has asthma_temporal rule"},
    {"section":"R",  "id":"R2",  "q":"Chronic bronchitis, COPD",
     "table":"applicant_medical_event","field":"icd10 J40-J44*","coverage":"CAPTURED"},
    {"section":"R",  "id":"R3",  "q":"Tuberculosis",
