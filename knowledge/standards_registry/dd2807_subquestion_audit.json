{
  "_meta": {
    "version": "v1-2026-05-24",
    "form": "DD 2807-2 — Accessions Medical Prescreen Report",
    "purpose": "Sub-question-level coverage map for DD 2807-2 (the pre-MEPS medical prescreen). Same shape as data/sf86_subquestion_audit.json so the same audit script works against both. The prescreen runs ~80 yes/no questions across head-to-toe medical history; this catalog lists each one with its target table.",
    "coverage_legend": {
      "CAPTURED":      "Sub-question has a dedicated structured column",
      "CAPTURED_ENC":  "Captured in an encrypted PII column",
      "DERIVED":       "Captured implicitly by another column",
      "NOTES":         "Captured only in free-text notes",
      "FORM_RESPONSE": "Captured only via applicant_form_response yes/no",
      "MISSING":       "No schema coverage yet"
    },
    "source": "OMB-approved DD 2807-2 form (latest revision DEC 2018 used as baseline). Question numbering follows the form's block structure."
  },
  "subquestions": [
    {"section":"1",  "id":"1",   "q":"Applicant identification (name/DOB/SSN)",
     "table":"applicant_profile","field":"full_name + dob + ssn","coverage":"CAPTURED_ENC"},
    {"section":"2",  "id":"2a",  "q":"Currently taking any prescription medication",
     "table":"applicant_medical_event","field":"event_type='medication' rows","coverage":"CAPTURED"},
    {"section":"2",  "id":"2b",  "q":"Allergies (food, drug, environmental)",
     "table":"applicant_medical_event","field":"event_type='allergy' rows","coverage":"CAPTURED"},
    {"section":"3",  "id":"3",   "q":"Family medical history (cancer, diabetes, cardiac, mental health)",
     "table":"(notes)","field":"applicant_family_member.notes","coverage":"NOTES",
     "note":"Family history isn't a dedicated table; can be added if MEPS objection arises"},

    {"section":"H",  "id":"H1",  "q":"Frequent or severe headaches / migraines",
     "table":"applicant_medical_event","field":"name ILIKE %migraine% OR icd10 G43*","coverage":"CAPTURED"},
    {"section":"H",  "id":"H2",  "q":"Head injury or skull fracture",
     "table":"applicant_medical_event","field":"event_type='injury' AND name ILIKE %head% OR %concussion%","coverage":"CAPTURED"},
    {"section":"H",  "id":"H3",  "q":"Dizziness or fainting spells",
     "table":"applicant_medical_event","field":"name ILIKE %syncope% OR %dizziness%","coverage":"CAPTURED"},

    {"section":"E",  "id":"E1",  "q":"Wear glasses, contacts, or had vision surgery",
     "table":"applicant_profile + applicant_medical_event","field":"vision_corrected + event_type='vision' rows","coverage":"CAPTURED"},
    {"section":"E",  "id":"E2",  "q":"Color vision deficiency",
     "table":"applicant_profile","field":"color_vision_normal","coverage":"CAPTURED"},
    {"section":"E",  "id":"E3",  "q":"Eye infections, glaucoma, retinal detachment",
     "table":"applicant_medical_event","field":"event_type='condition' AND name ILIKE %eye/glaucoma/retina%","coverage":"CAPTURED"},

    {"section":"EAR", "id":"EAR1","q":"Hearing loss or use of hearing aids",
     "table":"applicant_medical_event","field":"event_type='hearing' rows","coverage":"CAPTURED"},
    {"section":"EAR", "id":"EAR2","q":"Chronic ear infections, ruptured eardrum",
     "table":"applicant_medical_event","field":"name ILIKE %ear/eardrum/otitis%","coverage":"CAPTURED"},

    {"section":"N",  "id":"N1",  "q":"Frequent nosebleeds, deviated septum, sinus surgery",
     "table":"applicant_medical_event","field":"name ILIKE %nasal/sinus%","coverage":"CAPTURED"},
    {"section":"N",  "id":"N2",  "q":"Chronic sinusitis, hay fever",
     "table":"applicant_medical_event","field":"event_type='allergy' or condition='sinusitis'","coverage":"CAPTURED"},

    {"section":"M",  "id":"M1",  "q":"Severe tooth or jaw problems, jaw wired",
     "table":"applicant_medical_event","field":"event_type='dental' rows","coverage":"CAPTURED"},
    {"section":"M",  "id":"M2",  "q":"Speech problems / stuttering",
     "table":"applicant_medical_event","field":"name ILIKE %speech/stutter%","coverage":"CAPTURED"},

    {"section":"R",  "id":"R1",  "q":"Asthma after age 13",
